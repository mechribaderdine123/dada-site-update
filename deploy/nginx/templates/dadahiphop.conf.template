# Nginx site for Dada Hip Hop Academy - DEVELOPMENT VERSION
# This version does NOT require SSL certificates for local testing

upstream dadahiphop_app {
    server app:3000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name _;

    # MP3 uploads can be up to 75 MB; keep some headroom above that.
    client_max_body_size 90m;
    client_body_timeout 180s;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    location / {
        proxy_pass http://dadahiphop_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # Stream uploads straight through instead of buffering them on disk.
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
